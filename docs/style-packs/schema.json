{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deskpuff.app/schemas/style-pack-v1.json",
  "title": "DeskPuff External Style Package",
  "type": "object",
  "required": ["schemaVersion", "type", "id", "name"],
  "anyOf": [
    { "properties": { "palette": { "minProperties": 1 } }, "required": ["palette"] },
    { "properties": { "type": { "const": "cigarette" } }, "required": ["type", "diameterMM", "paper", "filter", "smoke"] },
    {
      "properties": {
        "type": { "const": "cigaretteBox" },
        "artwork": { "anyOf": [
          { "required": ["front"] },
          { "required": ["body"] }, { "required": ["scaledBody"] },
          { "required": ["lidOutside"] }, { "required": ["lidOutsideOpen"] }, { "required": ["lidInside"] }
        ] }
      },
      "required": ["type", "artwork"]
    },
    {
      "properties": {
        "type": { "const": "ashtray" },
        "artwork": { "required": ["whole"] }
      },
      "required": ["type", "artwork"]
    },
    {
      "properties": {
        "type": { "const": "lighter" },
        "artwork": { "required": ["whole"] }
      },
      "required": ["type", "artwork"]
    }
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "type": { "enum": ["cigarette", "cigaretteBox", "ashtray", "lighter"] },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "author": { "type": "string", "maxLength": 120 },
    "license": { "type": "string", "maxLength": 160 },
    "paletteBase": { "type": "string" },
    "cigaretteStyleId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "diameterMM": { "type": "number", "minimum": 5, "maximum": 11 },
    "paper": { "$ref": "#/$defs/cigarettePaper" },
    "filter": { "$ref": "#/$defs/cigaretteFilter" },
    "smoke": { "$ref": "#/$defs/cigaretteSmoke" },
    "brand": { "type": "string", "maxLength": 80 },
    "subtitle": { "type": "string", "maxLength": 120 },
    "preview": { "$ref": "#/$defs/pngPath" },
    "palette": { "$ref": "#/$defs/palette" },
    "artwork": { "$ref": "#/$defs/artwork" },
    "geometry": { "$ref": "#/$defs/geometry" }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "cigarette" } } },
      "then": {
        "required": ["diameterMM", "paper", "filter", "smoke"],
        "properties": { "artwork": { "$ref": "#/$defs/cigaretteArtwork" } }
      }
    },
    {
      "if": { "properties": { "type": { "const": "cigaretteBox" } } },
      "then": { "properties": { "artwork": { "properties": {
        "front": { "$ref": "#/$defs/pngPath" },
        "body": { "$ref": "#/$defs/pngPath" },
        "scaledBody": { "$ref": "#/$defs/pngPath" },
        "lidOutside": { "$ref": "#/$defs/pngPath" },
        "lidOutsideOpen": { "$ref": "#/$defs/pngPath" },
        "lidInside": { "type": "string", "deprecated": true, "description": "Legacy field. DeskPuff does not read the image." }
      } } } }
    },
    {
      "if": { "properties": { "type": { "const": "ashtray" } } },
      "then": { "properties": { "artwork": { "properties": {
        "whole": { "$ref": "#/$defs/pngPath" }
      } } } }
    }
  ],
  "$defs": {
    "pngPath": { "type": "string", "pattern": "^(?!/)(?!.*//)(?!.*(^|/)\\.\\.?(/|$))(?!.*\\\\).+\\.png$" },
    "color": { "type": "string", "pattern": "^#(?:[0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})$" },
    "gradient": { "type": "array", "minItems": 2, "maxItems": 4, "items": { "$ref": "#/$defs/color" } },
    "palette": {
      "type": "object",
      "properties": {
        "body": { "$ref": "#/$defs/gradient" }, "lid": { "$ref": "#/$defs/gradient" },
        "lidInterior": { "deprecated": true, "description": "Ignored by the shared interior renderer." }, "foil": { "$ref": "#/$defs/color" },
        "edge": { "$ref": "#/$defs/color" }, "fold": { "$ref": "#/$defs/color" },
        "mouthEdge": { "deprecated": true, "description": "Ignored by the shared interior renderer." }, "rim": { "$ref": "#/$defs/gradient" },
        "basin": { "$ref": "#/$defs/gradient" }, "trim": { "$ref": "#/$defs/color" },
        "bodyStroke": { "$ref": "#/$defs/color" }, "highlight": { "$ref": "#/$defs/color" },
        "handleFill": { "$ref": "#/$defs/color" }, "handleStroke": { "$ref": "#/$defs/color" },
        "handleGlyph": { "$ref": "#/$defs/color" }, "flame": { "$ref": "#/$defs/gradient" }
      },
      "additionalProperties": false
    },
    "artwork": {
      "type": "object",
      "properties": {
        "front": { "$ref": "#/$defs/pngPath" },
        "body": { "$ref": "#/$defs/pngPath" }, "scaledBody": { "$ref": "#/$defs/pngPath" },
        "lidOutside": { "$ref": "#/$defs/pngPath" }, "lidOutsideOpen": { "$ref": "#/$defs/pngPath" }, "lidInside": { "type": "string", "deprecated": true, "description": "Legacy field. DeskPuff does not read the image." },
        "whole": { "$ref": "#/$defs/pngPath" }
      },
      "additionalProperties": false
    },
    "geometry": {
      "type": "object",
      "properties": {
        "type": { "enum": ["standard-hard", "slim-hard"] },
        "lidBandFraction": { "type": "number", "minimum": 0.2, "maximum": 0.42 },
        "frontAspectRatio": { "type": "number", "minimum": 0.4, "maximum": 0.8 },
        "rowCounts": {
          "type": "array", "minItems": 1, "maxItems": 4,
          "items": { "type": "integer", "minimum": 1, "maximum": 10 }
        },
        "cigaretteCount": { "type": "integer", "minimum": 1, "maximum": 30 },
        "cigaretteDiameterMM": { "type": "number", "minimum": 4.5, "maximum": 10 },
        "basin": {
          "type": "array", "minItems": 4, "maxItems": 4,
          "prefixItems": [
            { "type": "number", "minimum": 0, "maximum": 1 },
            { "type": "number", "minimum": 0, "maximum": 1 },
            { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
            { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
          ],
          "items": false
        }
      },
      "additionalProperties": false
    },
    "hexColor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
    "cigarettePaper": {
      "type": "object", "required": ["color", "highlight", "shade"],
      "properties": { "color": { "$ref": "#/$defs/hexColor" }, "highlight": { "$ref": "#/$defs/hexColor" }, "shade": { "$ref": "#/$defs/hexColor" } },
      "additionalProperties": false
    },
    "cigaretteFilter": {
      "type": "object", "required": ["color", "highlight", "shade", "band"],
      "properties": { "color": { "$ref": "#/$defs/hexColor" }, "highlight": { "$ref": "#/$defs/hexColor" }, "shade": { "$ref": "#/$defs/hexColor" }, "band": { "$ref": "#/$defs/hexColor" } },
      "additionalProperties": false
    },
    "cigaretteSmoke": {
      "type": "object", "required": ["emissionMultiplier", "colorMode", "color"],
      "properties": { "emissionMultiplier": { "type": "number", "minimum": 0.25, "maximum": 3 }, "colorMode": { "enum": ["inheritGlobal", "custom"] }, "color": { "$ref": "#/$defs/hexColor" } },
      "additionalProperties": false
    },
    "cigaretteArtwork": {
      "type": "object",
      "properties": { "paper": { "$ref": "#/$defs/pngPath" }, "filter": { "$ref": "#/$defs/pngPath" }, "preview": { "$ref": "#/$defs/pngPath" } },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
